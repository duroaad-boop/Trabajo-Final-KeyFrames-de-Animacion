void menuGenerarReporte(const vector<Keyframe>& v,
                         const ReporteComparativo& rep) {
    if (v.empty()) {
        cout << "  No hay keyframes para generar el reporte.\n";
        return;
    }

    cout << "\n  === GENERAR REPORTE ===\n";
    cout << "  Total de keyframes a incluir: " << v.size() << "\n\n";
    cout << "  Formato:\n";
    cout << "    1. HTML  (recomendado → abrir en navegador → Ctrl+P → PDF)\n";
    cout << "    2. PostScript (.ps → convertir con ps2pdf)\n";
    cout << "    3. Ambos\n";
    cout << "  Opcion: ";

    int op; cin >> op;

    if (op == 1 || op == 3) {
        generarReporteHTML(v, rep, "data/reporte.html");
        cout << "  Instrucciones:\n";
        cout << "    1. Abrir 'data/reporte.html' en Chrome o Firefox\n";
        cout << "    2. Presionar Ctrl+P  (Cmd+P en Mac)\n";
        cout << "    3. En 'Destino' elegir 'Guardar como PDF'\n";
        cout << "    4. Click en 'Guardar'\n";
    }

    if (op == 2 || op == 3) {
        generarReportePS(v, "data/reporte.ps");
    }

    if (op < 1 || op > 3) {
        cout << "  [Error] Opcion invalida.\n";
    }
}
