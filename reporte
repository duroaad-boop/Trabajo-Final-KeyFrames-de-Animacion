// ============================================================
//  REPORTE POSTSCRIPT (convertible a PDF con ps2pdf)
// ============================================================
// Proposito : Genera un .ps (PostScript) con el listado
//             tabulado de keyframes. PostScript es texto plano
//             estandar que cualquier conversor puede leer.
//             Sin dependencias externas en C++.
// Parametros: v             - vector<Keyframe>
//             nombreArchivo - ruta del .ps a generar

void generarReportePS(const vector<Keyframe>& v,
                       const string& nombreArchivo) {
    ofstream f(nombreArchivo);
    if (!f.is_open()) {
        cout << "  [Error] No se pudo crear '" << nombreArchivo << "'.\n";
        return;
    }

    // Encabezado PostScript
    f << "%!PS-Adobe-3.0\n";
    f << "%%Title: Reporte Keyframes SIS-112\n";
    f << "%%Creator: GestorKeyframes v2.0\n";
    f << "%%CreationDate: " << obtenerFechaHora() << "\n";
    f << "%%Pages: 1\n";
    f << "%%EndComments\n\n";

    // Definir fuentes y helpers
    f << "/Helvetica-Bold findfont 14 scalefont setfont\n\n";

    // Coordenadas: origen PostScript en esquina inferior izquierda
    // Pagina carta: 612 x 792 puntos
    int pageW = 612, pageH = 792;
    int margen = 40;
    int y = pageH - margen;      // empezar desde arriba

    // ── Titulo ──────────
    f << pageW / 2 << " " << y - 5 << " moveto\n";
    f << "/Helvetica-Bold findfont 13 scalefont setfont\n";
    f << "(GESTOR DE KEYFRAMES DE ANIMACION) dup stringwidth pop 2 div neg 0 rmoveto show\n";
    y -= 18;
    f << "/Helvetica findfont 9 scalefont setfont\n";
    f << pageW / 2 << " " << y << " moveto\n";
    f << "(Programacion I - SIS-112  |  UCB San Pablo  |  2026) "
         "dup stringwidth pop 2 div neg 0 rmoveto show\n";
    y -= 6;

    // Linea separadora
    f << margen << " " << y << " moveto " << pageW - margen << " " << y << " lineto stroke\n";
    y -= 14;

    // ── Cabecera de columnas ──────────────
    f << "/Helvetica-Bold findfont 8 scalefont setfont\n";
    // Columnas: ID(30) Escena(80) Frame(40) Objeto(90) PosX(45) PosY(45) Rot(40) EscX(35) EscY(35) Ease(60)
    int cols[] = { 40, 80, 40, 90, 45, 45, 40, 35, 35, 60 };
    const char* hdrs[] = { "ID","Escena","Frame","Objeto","PosX","PosY","Rot","EscX","EscY","Ease" };
    int xc = margen;
    for (int i = 0; i < 10; i++) {
        f << xc << " " << y << " moveto (" << hdrs[i] << ") show\n";
        xc += cols[i];
    }
    y -= 4;
    f << margen << " " << y << " moveto " << pageW - margen << " " << y << " lineto stroke\n";
    y -= 11;

    // ── Filas de datos ──────
    f << "/Helvetica findfont 7.5 scalefont setfont\n";

    for (const Keyframe& k : v) {
        if (y < margen + 30) {
            // Nueva pagina si se acaba el espacio
            f << "showpage\n";
            y = pageH - margen;
        }

        xc = margen;
        // Cada campo como string PostScript
        string campos[] = {
            to_string(k.id),
            k.escena,
            to_string(k.frame),
            k.objeto,
            f1(k.posX),
            f1(k.posY),
            f1(k.rotacion),
            f1(k.escalaX),
            f1(k.escalaY),
            k.ease
        };

        for (int i = 0; i < 10; i++) {
            // Truncar si es muy largo para la columna
            string txt = campos[i];
            if ((int)txt.size() > cols[i] / 6)
                txt = txt.substr(0, cols[i] / 6 - 1) + ".";
            f << xc << " " << y << " moveto (" << txt << ") show\n";
            xc += cols[i];
        }
        y -= 10;

        // Linea divisoria fina cada fila
        f << "0.8 setgray\n";
        f << margen << " " << y + 2 << " moveto "
          << pageW - margen << " " << y + 2 << " lineto stroke\n";
        f << "0 setgray\n";
    }

    // ── Pie ─────────────
    y = margen;
    f << "0.5 setgray\n";
    f << margen << " " << y + 10 << " moveto " << pageW - margen << " "
      << y + 10 << " lineto stroke\n";
    f << "0 setgray\n";
    f << "/Helvetica findfont 7 scalefont setfont\n";
    f << margen << " " << y << " moveto (Generado: " << obtenerFechaHora()
      << "  |  Total: " << v.size() << " keyframes) show\n";

    f << "showpage\n";
    f << "%%EOF\n";
    f.close();

    cout << "  [OK] Reporte PostScript generado: '" << nombreArchivo << "'\n";
    cout << "  Para convertir a PDF ejecuta:\n";
    cout << "    ps2pdf " << nombreArchivo << " data/reporte.pdf\n";
}

// ============================================================
//  MENU DE GENERACION DE REPORTE
